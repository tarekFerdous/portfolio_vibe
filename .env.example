NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
ADMIN_EMAIL=your_admin_email@example.com

# Optional, server-only (never prefix with NEXT_PUBLIC_). Lets project pages render
# READMEs from private repos and raises the GitHub API rate limit. Use a fine-grained,
# read-only token with "Contents: Read" and "Metadata: Read" on the repos you showcase.
GITHUB_TOKEN=
